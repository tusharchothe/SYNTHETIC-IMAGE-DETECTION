# AI Image Detector - .gitignore

# ============================================================================
# Python
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints
*.ipynb

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# pdm
.pdm.toml

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# ============================================================================
# Machine Learning / Data
# ============================================================================

# Model checkpoints and weights
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.pb
*.onnx
*.tflite
*.joblib
*.pkl
*.pickle
*.safetensors

# Exceptions: Keep example/pretrained models (uncomment if needed)
# !resnet50_sd14_best.pt
# !clip_probe.joblib

# Large datasets (keep manifests, exclude images)
data/uploads/*.png
data/uploads/*.jpg
data/uploads/*.jpeg
data/uploads/*.webp
data/uploads/*.gif
data/downloads/
data/raw/
data/processed/
datasets/*/images/
datasets/*/raw/

# Keep dataset metadata
!datasets/*/manifest.jsonl
!datasets/*/split_definitions.json
!datasets/*/dataset_report.json
!datasets/versions.json

# Training artifacts (keep configs, exclude large files)
artifacts/training/*.pt
artifacts/training/*.pth
artifacts/registry/*.pt
artifacts/registry/*.pth

# MLflow tracking
mlruns/
mlartifacts/

# Experiment logs
experiments/
logs/
*.log

# TensorBoard
runs/
events.out.tfevents.*

# ============================================================================
# Databases
# ============================================================================

# SQLite databases (exclude production data, keep schema)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# Database backups
*.sql
*.dump

# Exceptions: Keep example/test databases (if needed)
# !tests/fixtures/*.db

# ============================================================================
# IDE / Editors
# ============================================================================

# VSCode
.vscode/
.vscode-test/
*.code-workspace

# PyCharm
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*\#
.\#*

# JetBrains (general)
*.iml
.idea/
out/

# ============================================================================
# Operating System
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ============================================================================
# Project Specific
# ============================================================================

# Local configuration (keep .env.example)
.env
.env.local
.env.*.local
config.local.yml
secrets.yml

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Upload directory contents (keep directory structure)
data/uploads/*
!data/uploads/.gitkeep

# Storage directory (if using different from uploads)
storage/*
!storage/.gitkeep

# Backup files
*.bak
*.backup
*.old
backup/

# Large assets (models, datasets)
assets/*.pt
assets/*.joblib
models/*.pt
models/*.joblib

# Gradio temporary files
gradio_cached_examples/
flagged/

# FastAPI / Uvicorn
.uvicorn_cache/

# Docker (if using)
.dockerignore

# ============================================================================
# Documentation (optional - keep docs in repo)
# ============================================================================

# Uncomment if you want to exclude generated docs
# docs/_build/
# docs/_static/
# docs/_templates/

# ============================================================================
# Security / Sensitive Files
# ============================================================================

# API keys and tokens
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
credentials.json
token.json
service-account.json

# SSH keys
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# ============================================================================
# Miscellaneous
# ============================================================================

# Compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Archives
*.tar.gz
*.tgz

# Version control
.git/
.gitattributes

# CI/CD
.github/workflows/secrets.yml

# Node modules (if using any JS tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================================
# Keep These Files (Examples)
# ============================================================================

# Uncomment lines below to force-include specific files
# !.env.example
# !requirements.txt
# !pyproject.toml
# !README.md
# !LICENSE
# !data/uploads/.gitkeep
# !artifacts/training/.gitkeep
# !datasets/.gitkeep
